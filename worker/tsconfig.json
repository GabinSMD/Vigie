{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": ["@cloudflare/workers-types", "node"]
  },
  "include": ["src", "../src/data/api.ts", "../src/data/snapshot.ts", "../src/data/types.ts", "../src/data/decision.ts", "../src/data/secrets.ts", "../src/data/ordre.ts"]
}
